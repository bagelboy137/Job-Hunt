# ── Job Search ────────────────────────────────────────────────────────────────
# Free tier: 200 req/month.  Sign up at:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Resume Matching (optional) ────────────────────────────────────────────────
# Required only if you want Claude to score job fit against your resume.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Commute Verification (optional) ──────────────────────────────────────────
# Enables exact driving-time checks for jobs near the 40-mile boundary.
# Console → APIs & Services → Distance Matrix API
# Leave blank to use straight-line distance only (works well for most cases).
GOOGLE_MAPS_KEY=

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# Google Account → Security → 2-Step Verification → App passwords → Create
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Paths (optional overrides) ────────────────────────────────────────────────
# Put your resume here as resume.pdf (PDF) or resume.txt (plain text)
# RESUME_PATH=resume/resume.pdf
