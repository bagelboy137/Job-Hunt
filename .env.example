# Adzuna API — free tier 1,000 req/month
# Sign up at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Resume matching via Claude AI (optional)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: exact driving-time checks near the 40-mile boundary
# Enable Distance Matrix API at: https://console.cloud.google.com
GOOGLE_MAPS_KEY=

# Gmail -- use an App Password (NOT your regular Gmail password)
# Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Path to your resume (PDF or plain text)
# RESUME_PATH=resume/resume.pdf
